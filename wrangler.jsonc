// Cloudflare Workers static-assets deployment (assets-only, no Worker
// script): `wrangler deploy` uploads dist/ and serves it from the edge.
// CI runs this on every push to main (.github/workflows/deploy.yml).
{
	// The existing Worker serving friction-cli.dev: deploying under this
	// name updates it in place, and its attached custom domain stays
	// attached — so a deploy with the CI secrets set goes live on the
	// real domain immediately.
	"name": "friction-cli",
	"compatibility_date": "2026-08-10",
	"assets": {
		"directory": "./dist",
		// "none" (the default, pinned here on purpose): a missing path is a
		// real 404. The friction loader probes ./packs/ with a HEAD request
		// to decide between locally staged models and the GitHub release
		// tag — an SPA-style index.html fallback would answer that probe
		// with 200 and the engine would try to parse HTML as model weights.
		"not_found_handling": "none"
	}

	// No routes block: friction-cli.dev is already attached to this
	// Worker as a custom domain in the dashboard, and that attachment
	// survives deploys. Add one only if the domain ever detaches:
	// "routes": [{ "pattern": "friction-cli.dev", "custom_domain": true }]
}
